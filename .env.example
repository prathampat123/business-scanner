# ──────────────────────────────────────────────────────────────────
# Business Scanner — environment variables
# Copy this file to .env and fill in values as needed.
# ──────────────────────────────────────────────────────────────────

# Optional: SerpAPI key enables Google Maps / Google Search results.
# Get a free key at https://serpapi.com (100 free searches/month).
SERPAPI_KEY=

# HTTP request timeout in seconds (default: 15)
REQUEST_TIMEOUT=15

# Maximum results returned per scraping source (default: 50)
MAX_RESULTS=50

# CORS origins — comma-separated (default: * for dev)
CORS_ORIGINS=*
